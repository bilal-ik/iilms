# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=iilms

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (Gmail SMTP — use App Password, NOT your real Gmail password)
# Setup: Google Account → Security → 2-Step Verification → App Passwords → Generate
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password_here
EMAIL_FROM=IILMS <your_gmail@gmail.com>

# Frontend URL
FRONTEND_URL=http://localhost:5173

